# Upstash Redis (Session & Signaling coordination across serverless instances)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# Backblaze B2 S3-compatible storage (Optional Encrypted Cloud Fallback)
# Note: In local dev, WebSend provides an automated in-memory mock if these are empty!
OBJECT_STORAGE_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
OBJECT_STORAGE_REGION="us-west-004"
OBJECT_STORAGE_ACCESS_KEY_ID="your_b2_application_key_id"
OBJECT_STORAGE_SECRET_ACCESS_KEY="your_b2_application_key"
OBJECT_STORAGE_BUCKET="websend-transfers"
# Existing Cloudflare R2 deployments can keep their R2_* settings during migration.

# Cron secret for automated temporary cleanup
CRON_SECRET="your_secure_cron_secret"

# Dedicated TURN relay (recommended for cross-network connections)
# Use the URLs and credentials supplied by your TURN provider.
# Include turns: on port 443 where supported for networks blocking UDP.
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
# For coturn REST authentication, set this instead of username/credential:
TURN_SHARED_SECRET=""

# Cloudflare Realtime TURN (preferred when both are configured)
# Create a TURN key in Cloudflare Realtime and keep its API token server-side.
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
